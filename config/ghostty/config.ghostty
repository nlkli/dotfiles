palette = 2=#8bc49c
palette = 3=#e9c366
palette = 4=#78b9e8
palette = 5=#c79cda
palette = 6=#74d5d6
palette = 7=#e6d8b9
palette = 8=#394146
palette = 9=#ed9e78
palette = 10=#99cba8
palette = 11=#ecca78
palette = 12=#88c1eb
palette = 13=#cea8de
palette = 14=#85dadb
palette = 15=#e9ddc6
background = #102c3c
foreground = #f8e9ca
cursor-color = #ecca78
cursor-text = #102c3c
selection-background = #3e4556
selection-foreground = #f8e9ca
