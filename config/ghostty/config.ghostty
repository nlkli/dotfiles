# title = ""
# macos-titlebar-style = transparent
# macos-window-buttons = hidden
# window-subtitle = false
# window-decoration = auto
confirm-close-surface = false
custom-shader = shaders/cursor_tail.glsl
custom-shader = shaders/ripple_cursor.glsl
mouse-hide-while-typing = true
shell-integration-features = no-cursor
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true
cursor-style = block
cursor-style-blink = false
font-size = 22
font-family = ZedMono Nerd Font Mono
font-style = Bold
palette = 0=#8b3a1b
palette = 1=#d3542c
palette = 2=#7a9b45
palette = 3=#d9a441
palette = 4=#468bd6
palette = 5=#b05cc7
palette = 6=#4db7a0
palette = 7=#e06b8f
palette = 8=#8c5a3c
palette = 9=#e67356
palette = 10=#9bba5d
palette = 11=#d6ad45
palette = 12=#65b8e8
palette = 13=#c889e0
palette = 14=#57c8b4
palette = 15=#f4a7c3
background = #fff0e3
foreground = #6b3d2a
cursor-color = #c97b2e
cursor-text = #6b3d2a
selection-background = #d28b6c
selection-foreground = #7d4c38
palette = 16=#d67c37
palette = 17=#da605e
