# title = ""
# macos-titlebar-style = transparent
# macos-window-buttons = hidden
# window-subtitle = false
# window-decoration = auto
confirm-close-surface = false
custom-shader = shaders/cursor_tail.glsl
custom-shader = shaders/ripple_cursor.glsl
mouse-hide-while-typing = true
shell-integration-features = no-cursor
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true
cursor-style = block
cursor-style-blink = false
font-size = 22
font-family = ZedMono Nerd Font Mono
font-style = Bold
palette = 0=#0d0c0c
palette = 1=#d17f79
palette = 2=#8a9a7b
palette = 3=#b3a27a
palette = 4=#8ba4b0
palette = 5=#a292a3
palette = 6=#8ea4a2
palette = 7=#bdb589
palette = 8=#a4a7a4
palette = 9=#e46876
palette = 10=#87a987
palette = 11=#caa86b
palette = 12=#7fb4ca
palette = 13=#938aa9
palette = 14=#7aa89f
palette = 15=#b8bcba
background = #090e13
foreground = #c5c9c7
cursor-color = #c5c9c7
cursor-text = #090e13
selection-background = #393b44
selection-foreground = #c5c9c7
palette = 16=#c3917a
palette = 17=#bb8f75
