# title = ""
# macos-titlebar-style = transparent
# macos-window-buttons = hidden
# window-subtitle = false
# window-decoration = auto
confirm-close-surface = false
custom-shader = shaders/cursor_tail.glsl
custom-shader = shaders/ripple_cursor.glsl
mouse-hide-while-typing = true
shell-integration-features = no-cursor
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true
cursor-style = block
cursor-style-blink = false
font-size = 22
font-family = ZedMono Nerd Font Mono
font-style = Bold
palette = 0=#292722
palette = 1=#ef7d69
palette = 2=#89b67c
palette = 3=#d6aa4a
palette = 4=#82a8c8
palette = 5=#b49ac7
palette = 6=#78b8b0
palette = 7=#ccc2ad
palette = 8=#827b6d
palette = 9=#ffb39d
palette = 10=#b8e3a5
palette = 11=#ffd36b
palette = 12=#b4d7f2
palette = 13=#e3c4f3
palette = 14=#a6e7de
palette = 15=#f5ebd5
background = #10100f
foreground = #f0e6ce
cursor-color = #e6b74e
cursor-text = #10100f
selection-background = #55431f
selection-foreground = #fff6e5
palette = 16=#e3955b
palette = 17=#d5907a
